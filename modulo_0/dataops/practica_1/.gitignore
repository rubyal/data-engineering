# Terraform local working directory
**/.terraform/*

# Terraform state (may contain sensitive values)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config and credentials
.terraformrc
terraform.rc

# Saved plans
*.tfplan
*.tfplan.json
plan.out

# Secrets and local variable overrides
*.auto.tfvars
*.auto.tfvars.json
*.tfvars.json
!terraform.tfvars

# System/editor
.DS_Store
.idea/
.vscode/
